# Copy this file to private/secrets.env and fill in the values locally.
# Do not quote values. Do not commit private/secrets.env.

# Final protected URL that serves the rendered Surge profile itself.
SURGE_MANAGED_URL=

HTTPS_USERNAME=
HTTPS_PASSWORD=
TUIC_USERNAME=
TUIC_PASSWORD=
TUIC_UUID=
HY2_USERNAME=
HY2_PASSWORD=
EDGETUNNEL_UUID=

# Key for the local Surge HTTP API (http-api = <key>@0.0.0.0:6171).
HTTP_API_KEY=
